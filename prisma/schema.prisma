generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nome         String?
  role         UserRole  @default(USER)

  sessions     Session[]
  sites        Site[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailMessage {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fromAddr  String
  toAddr    String
  subject   String?
  texto     String?
  html      String?
  codigo    String?
  lido      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

model Lead {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  nome        String
  email       String?
  telefone    String?
  mensagem    String
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([siteId, createdAt])
}

model Site {
  id              String   @id @default(cuid())

  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  cnpj            String   @unique
  razaoSocial     String
  nomeFantasia    String?
  endereco        Json
  telefone        String?
  emailContato    String?
  cnaeFiscal      String?
  cnaeDescricao   String?
  capitalSocial   Decimal?
  dataAbertura    DateTime?
  socios          Json?
  receitaRaw      Json

  slug            String   @unique

  heroTitulo      String?
  heroSubtitulo   String?
  sobre           String?
  missao          String?
  visao           String?
  servicos        Json?
  rodape          String?

  logoUrl         String?
  heroImageUrl    String?

  corPrimaria     String?
  corSecundaria   String?

  whatsapp        String?
  instagram       String?
  facebook        String?
  linkedin        String?
  horarioAtend    String?

  dominioProprio  String?  @unique
  dominioStatus   DominioStatus @default(NAO_CADASTRADO)
  dominioVerifEm  DateTime?
  cnameAlvo       String?

  emailHandle     String?
  emailForwardTo  String?
  emailStatus     EmailStatus @default(NAO_CONFIGURADO)
  emailVerifEm    DateTime?
  mxRecords       Json?
  spfRecord       String?

  metaTitle       String?
  metaDescription String?
  metaPixel       String?
  metaCapiToken   String?
  gaId            String?

  ativo           Boolean  @default(true)

  leads           Lead[]
  emails          EmailMessage[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([dominioProprio])
  @@index([cnpj])
  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

enum DominioStatus {
  NAO_CADASTRADO
  PENDENTE_DNS
  VERIFICADO
  FALHA
}

enum EmailStatus {
  NAO_CONFIGURADO
  PENDENTE_MX
  VERIFICADO
  FALHA
}
